{
  "manifest_version": 2,
  "name": "AFFiNE Sidebar",
  "version": "1.2.0",
  "description": "Embeds your self-hosted AFFiNE instance as a Firefox sidebar panel.",

  "icons": {
    "16": "icons/affine-64.png",
    "48": "icons/affine-64.png",
    "96": "icons/affine-512.png"
  },

  "sidebar_action": {
    "default_title": "AFFiNE",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/affine-64.png",
      "48": "icons/affine-64.png",
      "96": "icons/affine-512.png"
    }
  },

  "browser_action": {
    "default_title": "AFFiNE Sidebar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/affine-64.png",
      "48": "icons/affine-64.png",
      "96": "icons/affine-512.png"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "permissions": ["storage"]
}
