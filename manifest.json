{
  "manifest_version": 2,
  "name": "AFFiNE Sidebar",
  "version": "1.5.0",
  "description": "Embeds your self-hosted AFFiNE instance as a Firefox sidebar panel.",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "sidebar_action": {
    "default_title": "AFFiNE",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "browser_action": {
    "default_title": "AFFiNE Sidebar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "permissions": ["storage", "*://*/*"],

  "browser_specific_settings": {
    "gecko": {
      "id": "affine-sidebar@avernus.cloud",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
