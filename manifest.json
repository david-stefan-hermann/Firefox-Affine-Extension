{
  "manifest_version": 2,
  "name": "AFFiNE Sidebar",
  "version": "1.1.0",
  "description": "Embeds your self-hosted AFFiNE instance as a Firefox sidebar panel.",

  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "sidebar_action": {
    "default_title": "AFFiNE",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "browser_action": {
    "default_title": "AFFiNE Sidebar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },

  "permissions": ["storage"]
}
